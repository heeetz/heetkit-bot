# Twitch application identity. Register this exact callback URL in the Twitch Developer Console.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_BOT_USER_ID=your_bot_twitch_user_id
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_CHANNEL_USER_ID=your_channel_twitch_user_id
TWITCH_CHANNEL=your_channel_name

# TwitchIO tokens are stored in the platform app-data directory; never put tokens here.

# Optional AI integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_COOLDOWN_BYPASS_USER_ID=

# Local defaults (SQLite is stored in the platform app-data directory)
LOG_LEVEL=INFO
COMMAND_PREFIX=!
COMMAND_MAX_ARGUMENTS_LENGTH=300
