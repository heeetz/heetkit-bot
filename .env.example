# Twitch application identity. Register this exact callback URL in the Twitch Developer Console.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_BOT_USER_ID=your_bot_twitch_user_id
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_CHANNEL_USER_ID=your_channel_twitch_user_id
TWITCH_CHANNEL=your_channel_name

# TwitchIO-managed User Access Token storage. Do not add access or refresh tokens to this file.
TWITCH_TOKEN_FILE=data/twitchio_tokens.json

# Optional AI integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_COOLDOWN_BYPASS_USER_ID=

# Local defaults
DATABASE_URL=sqlite+aiosqlite:///./data/twitch_bot.db
LOG_LEVEL=INFO
COMMAND_PREFIX=!
COMMAND_MAX_ARGUMENTS_LENGTH=300
